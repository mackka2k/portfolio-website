{
	"extends": ["next/core-web-vitals"],
	"rules": {
		"react/no-unescaped-entities": "warn",
		"react/display-name": "off",
		"no-unused-vars": [
			"warn",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"ignoreRestSiblings": true
			}
		],
		"@next/next/no-img-element": "warn"
	}
}
